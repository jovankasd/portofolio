# ============================================================
# OBSIDIAN & ATMOSPHERE — .gitignore
# ============================================================

# --- Dependencies & Package Managers ---
node_modules/
/.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn/install-state.gz

# --- Next.js & Build Outputs ---
.next/
out/
build/
dist/
.turbo/
.cache/

# --- Environment & Secret Files (CRITICAL - DO NOT COMMIT) ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# --- IDE & Editor Files ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iws
*.iml
*.ipr
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Testing & Coverage ---
coverage/
*.lcov
.nyc_output

# --- Debug & Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Deployment Platforms ---
.vercel/

# --- Local AI & Agent Artifacts ---
/graphify-out/
/.superpowers/
