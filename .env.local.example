# ============================================================
# OBSIDIAN & ATMOSPHERE — Environment Variables
# ============================================================
# Salin file ini menjadi .env.local dan isi nilainya.
# JANGAN commit .env.local ke git.

# --- Supabase (Public — aman di client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (Server-only — TIDAK boleh prefix NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Admin Auth ---
# Hash argon2/bcrypt dari master key Anda.
# Generate dengan: node -e "const b=require('bcryptjs');b.hash('YOUR_KEY',12).then(console.log)"
ADMIN_MASTER_KEY_HASH=$2b$12$REPLACE_WITH_ACTUAL_BCRYPT_HASH

# Secret untuk menandatangani cookie sesi iron-session (min 32 karakter acak)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-32-char-random-hex-string-here

# --- App URL (untuk produksi) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
